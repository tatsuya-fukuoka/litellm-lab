# 推奨: scripts/init_env.sh で .env を作る（鍵をランダム生成する）。手で作る場合は REPLACE_ME を必ず置き換えること。
# 生成例: echo "sk-$(openssl rand -hex 24)"
# 公式の署名付きイメージ（v1.83.0-nightly以降でcosign署名）。必ず固定タグにする。
# タグ名は https://github.com/BerriAI/litellm/releases で確認すること（latestは使わない）
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.108.0
LITELLM_MASTER_KEY=sk-REPLACE_ME
LITELLM_SALT_KEY=sk-REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
# 本番想定: ERROR（DEBUGは遅延の最大要因）
LITELLM_LOG=ERROR
# ホスト側の公開ポート（衝突したら変更。コンテナ内部のポートは変わらない）
# Windowsでは 9001/9002 付近が予約・使用中のことがあるため、既定は 19001/19002
LITELLM_PORT=4000
MOCK_PRIMARY_PORT=19001
MOCK_BACKUP_PORT=19002

# ワーカー数。LiteLLM: 単一VMならvCPU数、Kubernetesなら1 Pod 1ワーカーで横に増やすのが公式推奨。
LITELLM_WORKERS=1
# モックのワーカー数。並列を上げて「直接呼び出し」側が先に詰まる場合だけ増やす。
# 注意: モックの状態(障害注入・カウンタ)はプロセスごとなので、test_fallback.py は 1 のまま実行すること。
MOCK_WORKERS=1

# 使う設定ファイル。既定は ./litellm_config.yaml（安定版）。
# 問題の再現: ./configs/cooldown_pitfall.yaml
LITELLM_CONFIG=./litellm_config.yaml

# 公開するアドレス。既定は手元のみ(127.0.0.1)。別マシンのクライアントから測るEC2構成では 0.0.0.0 にし、
# セキュリティグループで「クライアントのSGからのみ」に絞ること（マスターキーとモックの管理APIが無認証で露出するため）。
BIND_ADDR=127.0.0.1
# --- クライアント側マシンの .env にだけ書く（サーバ側のプライベートIPを指す）---
# LITELLM_URL=http://10.0.1.10:4000
# MOCK_PRIMARY_URL=http://10.0.1.10:19001
# MOCK_BACKUP_URL=http://10.0.1.10:19002
